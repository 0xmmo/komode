{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "komode": [
        "./src/index.ts"
      ],
      "komode/sandbox": [
        "./src/sandbox/index.ts"
      ],
      "komode/mcp": [
        "./src/mcp/index.ts"
      ],
      "komode/ai-sdk": [
        "./src/adapters/ai-sdk.ts"
      ],
      "komode/openai-agents": [
        "./src/adapters/openai-agents.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
